# Gradle
.gradle/
build/
# The wrapper jar is intentionally committed: without it a fresh clone cannot
# bootstrap the exact Gradle version the build is pinned to.
!gradle/wrapper/gradle-wrapper.jar

# Kotlin compiler session data
.kotlin/

# Local SDK location; machine-specific
local.properties

# Signing key material — must never be committed. The keystore lives only on your
# machine and in GitHub Actions secrets; keystore.properties holds its passwords for
# local release builds. CI decodes the keystore from a secret at build time.
*.jks
*.keystore
keystore.properties
upload-key*.b64

# Native build scratch
.cxx/
build-host/
build-android/

# IDE
.idea/
*.iml
